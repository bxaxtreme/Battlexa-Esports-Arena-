# Required for production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/battlexa
MONGODB_DB=battlexa
ADMIN_USERNAME=xtreme
# Use a long, unique password. Never commit your real .env file.
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Generate a 32+ character random secret for signing admin sessions.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set true behind HTTPS in production (Vercel/most hosted platforms)
COOKIE_SECURE=false
NEXT_PUBLIC_SITE_URL=https://your-real-domain.example\nNEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/
